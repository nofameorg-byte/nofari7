{
  "expo": {
    "name": "NOFARI",
    "slug": "nofari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nofari-face.png",
    "scheme": "nofari",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nofari.nofari8",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NOFARI Circle needs microphone access so users can speak in voice rooms.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nofari.nofari8",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.nofari.nofari.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.nofari.nofari.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "81210230-952f-45fa-9bcd-55f2551e6729"
      }
    }
  }
}
