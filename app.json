{
  "expo": {
    "name": "NOFARI",
    "slug": "nofari",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nofari-face.png",
    "scheme": "nofari",
    "userInterfaceStyle": "automatic",

    "splash": {
      "backgroundColor": "#0B1E6D",
      "resizeMode": "contain",
      "image": "./assets/images/nofari-face.png"
    },

    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ]
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nofari.nofari8",
      "buildNumber": "23",

      "splash": {
        "backgroundColor": "#0B1E6D"
      },

      "infoPlist": {
        "NSMicrophoneUsageDescription": "NOFARI Circle needs microphone access so users can speak in voice rooms.",
        "NSCameraUsageDescription": "NOFARI uses the camera for Face2Face video calls between users.",
        "NSLocationWhenInUseUsageDescription": "NOFARI may access location features if safety tools are enabled.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nofari.nofari8",
      "versionCode": 23,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1E6D"
      }
    },

    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.nofari.nofari8.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.nofari.nofari.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "81210230-952f-45fa-9bcd-55f2551e6729"
      }
    }
  }
}